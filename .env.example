# Generate your own Django secret key for local development.
DJANGO_SECRET_KEY=

# Gmail integration — configure these to connect a Gmail account.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://127.0.0.1:8000/accounts/google/callback/

# Generate a Fernet key before connecting Gmail.
GMAIL_TOKEN_ENCRYPTION_KEY=

# Local development only. Production must use False and its actual hostname.
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost